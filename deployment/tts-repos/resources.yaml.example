# TTS-Audio-Suite bridge resource registry.
#
# Copy this file to a machine-local resources.yaml, replace the empty mapping
# with the resources used on that machine, then set TTS_AUDIO_SUITE_RESOURCES
# to the copied file. Never commit the populated file.
# Each engine defaults to <source_root>/.venv/Scripts/python.exe. Set the
# optional private python_executable field on any engine only for an existing,
# absolute regular interpreter path (links and Windows reparse paths are rejected).
version: 1
resources: {}

# CosyVoice example (replace `resources: {}` above with `resources:` first):
#   cosyvoice-local:
#     engine: cosyvoice
#     source_root: <cosyvoice-checkout>
#     model_dir: <cosyvoice-model-directory>
#
# IndexTTS example:
#   indextts-local:
#     engine: index_tts
#     source_root: <indextts-checkout>
#     model_dir: <indextts-checkpoints-directory>
#
# GPT-SoVITS example:
#   gpt-sovits-local:
#     engine: gpt_sovits
#     source_root: <gpt-sovits-checkout>
#     gpt_weight: <gpt-checkpoint-file>
#     sovits_weight: <sovits-checkpoint-file>
#     bert_path: <bert-model-directory>
#     cnhubert_path: <cnhubert-model-directory>
#     version: v2ProPlus
#     # Optional on any engine when checkout-local .venv is not the intended runtime:
#     # python_executable: <compatible-python-executable>
